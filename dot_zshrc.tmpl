# =========================================================================
# GLOBAL CONFIGS (Load in all terminals: Ghostty, iTerm, VSCode, etc.)
# =========================================================================

# PATH & Environment
export PATH="$HOME/.local/bin:$HOME/bin:/usr/local/bin:$PATH"
export PATH="$PATH":"$HOME/.pub-cache/bin"
# Homebrew: login shells get this from ~/.zprofile. Many IDE terminals are
# non-login and only source ~/.zshrc — wire brew here too (skip if already on PATH).
if ! command -v brew &>/dev/null; then
  if [[ -x /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  elif [[ -x /usr/local/bin/brew ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
  fi
fi
export EDITOR='code --wait'
export VISUAL='code'
export SHELL='/bin/zsh'

# Custom completions
fpath=("$HOME/.local/share/zsh/completions" $fpath)

# HISTORY
[ -z "$HISTFILE" ] && HISTFILE="$HOME/.zhistory"
HISTSIZE=290000
SAVEHIST=$HISTSIZE

# SETOPT
setopt extended_history
setopt hist_expire_dups_first
setopt hist_ignore_all_dups
setopt hist_ignore_space
setopt hist_verify
setopt inc_append_history
setopt share_history
setopt always_to_end
setopt hash_list_all
setopt complete_in_word
setopt nocorrect
setopt list_ambiguous
unsetopt BEEP

# COLORING
autoload colors && colors
# Fix for terminal artifacts (OSC 11 / CSI queries)
# Some tools like 'bat' and 'delta' query the terminal for background color.
# Setting these variables satisfies the tools so they don't query.
export COLORTERM=truecolor
export COLORFGBG="15;0"
export BAT_THEME="Dracula"

# ALIASES
if [ -f $HOME/.zsh_aliases ]; then
    source $HOME/.zsh_aliases
fi

# YAZI Function (Modern File Manager)
function ya() {
  local tmp="$(mktemp -t "yazi-cwd.XXXXX")"
  yazi "$@" --cwd-file="$tmp"
  if cwd="$(cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
    cd -- "$cwd"
  fi
  rm -f -- "$tmp"
}

# mise (Tool Manager)
export PATH="$HOME/.local/share/mise/shims:$PATH"
if command -v mise &>/dev/null; then
  eval "$(mise activate zsh)"
fi

# =========================================================================
# INTERACTIVE SHELL CONFIGS
# =========================================================================
if [[ $- == *i* ]]; then

  # Starship Prompt (Fast & Universal)
  if command -v starship &>/dev/null; then
    eval "$(starship init zsh)"
  fi

  # zinit plugin manager
  ZINIT_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}/zinit/zinit.git"
  if [ -d "$ZINIT_HOME" ]; then
    source "${ZINIT_HOME}/zinit.zsh"

    # Autosuggestion style: explicit dim color so it never looks like typed text
    ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=#6c6c6c,italic"
    ZSH_AUTOSUGGEST_STRATEGY=(history)   # history only, no completion suggestions

    # Plugins in Turbo Mode (Instant startup)
    zinit ice wait"0a" lucid; zinit light zsh-users/zsh-autosuggestions
    zinit ice wait"0b" lucid blockf; zinit light zsh-users/zsh-completions
    zinit ice wait"0c" lucid; zinit light Aloxaf/fzf-tab
    zinit ice wait"0d" lucid atinit="zpcompinit;zpcdreplay"; zinit light zdharma-continuum/fast-syntax-highlighting
    zinit ice wait"0e" lucid; zinit load wfxr/forgit
    zinit ice wait"0f" lucid; zinit snippet OMZP::git
  fi

  # Shell Integration (FZF, Zoxide, Atuin)
  if command -v zoxide &>/dev/null; then
    eval "$(zoxide init zsh --cmd cd)"
    alias z='cd'
    alias zi='cdi'
  fi
  command -v fzf &>/dev/null && eval "$(fzf --zsh)"
  command -v atuin &>/dev/null && eval "$(atuin init zsh)"

  # Completion styles
  zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'
  zstyle ':completion:*' menu no
  zstyle ':fzf-tab:*' fzf-flags --height=50% --layout=default --info=inline
  
  # Context-specific previews for fzf-tab
  zstyle ':fzf-tab:complete:(cd|z):*' fzf-preview 'eza -1 --icons --color=always --group-directories-first $realpath 2>/dev/null'
  zstyle ':fzf-tab:complete:ls:*' fzf-preview 'eza -1 --icons --color=always $realpath 2>/dev/null'
  zstyle ':fzf-tab:complete:cat:*' fzf-preview 'bat --style=numbers --color=always --line-range :200 $realpath 2>/dev/null'

  # Fancy Ctrl-Z (toggle between process and shell)
  function fg-fzf() {
    job="$(jobs | fzf -0 -1 | sed -E 's/\[(.+)\].*/\1/')" && echo '' && fg %$job
  }
  function fancy-ctrl-z () {
    if [[ $#BUFFER -eq 0 ]]; then
      BUFFER=" fg-fzf"
      zle accept-line -w
    else
      zle push-input -w
      zle clear-screen -w
    fi
  }
  zle -N fancy-ctrl-z
  bindkey '^Z' fancy-ctrl-z

fi

{{ if .is_work -}}
### MANAGED BY RANCHER DESKTOP START (DO NOT EDIT)
export PATH="$HOME/.rd/bin:$PATH"
### MANAGED BY RANCHER DESKTOP END (DO NOT EDIT)
# ZIA-CERT-STORE-MANAGED profile.d sourcing
if [ -d /etc/profile.d ]; then
  for _zia_f in /etc/profile.d/*.sh; do [ -f "$_zia_f" ] && . "$_zia_f"; done
  unset _zia_f
fi
# ZIA-CERT-STORE-MANAGED-END
{{ end -}}

# Stub for VS Code/Cursor/Claude shell integration.
# Silences 'command not found: dump_zsh_state' when their
# shell integration script fails to fully load.
(( ${+functions[dump_zsh_state]} )) || function dump_zsh_state() { :; }

# Local overrides (unmanaged): machine-specific shell bits go in ~/.zsh_local,
# never in ~/.zshrc. ~/.zshrc is chezmoi-managed: hand edits (including tool
# installers appending init snippets) show up as drift in
# `dotfiles-sync --check` and are reverted by the next `chezmoi apply`.
if [ -f "$HOME/.zsh_local" ]; then
  source "$HOME/.zsh_local"
fi
