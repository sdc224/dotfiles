<keymap version="1" name="DarculaCopy" parent="Darcula">
  <!-- Ctrl-first keymap mirroring dot_config/ide/keybindings.json (VS Code/Cursor/Windsurf).
       Work-only install; personal trials flip install_intellij (see .chezmoi.toml.tmpl).
       ctrl+c copies selection, otherwise it still interrupts nothing in the IDE. -->
  <action id="$Copy"><keyboard-shortcut first-keystroke="ctrl C" /></action>
  <action id="$Cut"><keyboard-shortcut first-keystroke="ctrl X" /></action>
  <action id="$Paste"><keyboard-shortcut first-keystroke="ctrl V" /></action>
  <action id="$SelectAll"><keyboard-shortcut first-keystroke="ctrl A" /></action>
  <action id="$Undo"><keyboard-shortcut first-keystroke="ctrl Z" /></action>
  <action id="$Redo">
    <keyboard-shortcut first-keystroke="ctrl Y" />
    <keyboard-shortcut first-keystroke="ctrl shift Z" />
  </action>
  <action id="CommentByLineComment"><keyboard-shortcut first-keystroke="ctrl SLASH" /></action>
  <action id="CommentByBlockComment"><keyboard-shortcut first-keystroke="ctrl shift SLASH" /></action>
  <action id="ShowIntentionActions"><keyboard-shortcut first-keystroke="ctrl PERIOD" /></action>
  <action id="ReformatCode"><keyboard-shortcut first-keystroke="ctrl shift I" /></action>
  <action id="SaveAll"><keyboard-shortcut first-keystroke="ctrl S" /></action>
  <action id="NewFile"><keyboard-shortcut first-keystroke="ctrl N" /></action>
  <action id="OpenFile"><keyboard-shortcut first-keystroke="ctrl O" /></action>
  <action id="CloseContent"><keyboard-shortcut first-keystroke="ctrl W" /></action>
  <action id="GotoFile"><keyboard-shortcut first-keystroke="ctrl P" /></action>
  <action id="GotoAction"><keyboard-shortcut first-keystroke="ctrl shift P" /></action>
  <action id="GotoLine"><keyboard-shortcut first-keystroke="ctrl G" /></action>
  <action id="GotoSymbol"><keyboard-shortcut first-keystroke="ctrl T" /></action>
  <action id="RecentFiles"><keyboard-shortcut first-keystroke="ctrl shift O" /></action>
  <action id="ActivateProjectToolWindow"><keyboard-shortcut first-keystroke="ctrl shift E" /></action>
  <action id="ActivateVersionControlToolWindow"><keyboard-shortcut first-keystroke="ctrl shift G" /></action>
  <action id="ActivateTerminalToolWindow"><keyboard-shortcut first-keystroke="ctrl QUOTE" /></action>
  <action id="CompileDirty"><keyboard-shortcut first-keystroke="ctrl shift B" /></action>
</keymap>
