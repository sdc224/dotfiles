// Place your key bindings in this file to override the defaultsauto[]
[
  {
    "key": "cmd+p",
    "command": "-workbench.action.quickOpen"
  },
  {
    "key": "ctrl+p",
    "command": "workbench.action.openSettings"
  },
  {
    "key": "cmd+,",
    "command": "-workbench.action.openSettings"
  },
  {
    "key": "ctrl+,",
    "command": "-workbench.action.quickOpen"
  },
  {
    "key": "ctrl+,",
    "command": "workbench.action.quickOpen"
  },
  {
    "key": "ctrl+g",
    "command": "workbench.action.gotoLine"
