// Cross-platform keybindings (Ctrl-first). Designed to let `Ctrl` work the same on mac/linux/win.
// Add or extend entries here for additional extension commands as needed.
[
  // Clipboard + editing
  {
    "key": "ctrl+c",
    "command": "editor.action.clipboardCopyAction",
    "when": "editorTextFocus && !editorReadonly"
  },
  {
    "key": "ctrl+x",
    "command": "editor.action.clipboardCutAction",
    "when": "editorTextFocus && !editorReadonly"
  },
  {
    "key": "ctrl+v",
    "command": "editor.action.clipboardPasteAction",
    "when": "editorTextFocus && !editorReadonly"
  },
  {
    "key": "ctrl+a",
    "command": "editor.action.selectAll",
    "when": "textInputFocus"
  },
  { "key": "ctrl+z", "command": "undo", "when": "textInputFocus" },
  { "key": "ctrl+y", "command": "redo", "when": "textInputFocus" },
  { "key": "ctrl+shift+z", "command": "redo", "when": "textInputFocus" },
  {
    "key": "ctrl+/,",
    "command": "editor.action.commentLine",
    "when": "editorTextFocus && !editorReadonly"
  },
  {
    "key": "ctrl+shift+/,",
    "command": "editor.action.blockComment",
    "when": "editorTextFocus && !editorReadonly"
  },
  {
    "key": "ctrl+.",
    "command": "editor.action.quickFix",
    "when": "editorHasCodeActionsProvider && editorTextFocus"
  },
  {
    "key": "ctrl+shift+i",
    "command": "editor.action.formatDocument",
    "when": "editorHasDocumentFormattingProvider && editorTextFocus"
  },

  // File + workspace commands
  { "key": "ctrl+s", "command": "workbench.action.files.save" },
  { "key": "ctrl+shift+s", "command": "workbench.action.files.saveAs" },
  { "key": "ctrl+alt+s", "command": "workbench.action.files.saveAll" },
  { "key": "ctrl+n", "command": "workbench.action.files.newUntitledFile" },
  { "key": "ctrl+o", "command": "workbench.action.files.openFile" },
  { "key": "ctrl+w", "command": "workbench.action.closeActiveEditor" },
  { "key": "ctrl+shift+w", "command": "workbench.action.closeWindow" },
  { "key": "ctrl+k ctrl+w", "command": "workbench.action.closeAllEditors" },
  { "key": "ctrl+shift+t", "command": "workbench.action.reopenClosedEditor" },
  { "key": "ctrl+shift+n", "command": "workbench.action.newWindow" },
  { "key": "ctrl+shift+r", "command": "workbench.action.reloadWindow" },
  { "key": "ctrl+shift+o", "command": "workbench.action.openRecent" },

  // Quick open + navigation
  { "key": "ctrl+p", "command": "workbench.action.quickOpen" },
  { "key": "ctrl+shift+p", "command": "workbench.action.showCommands" },
  { "key": "ctrl+g", "command": "workbench.action.gotoLine" },
  { "key": "ctrl+t", "command": "workbench.action.showAllSymbols" },

  // Tab + editor group navigation
  { "key": "ctrl+tab", "command": "workbench.action.openNextEditor" },
  { "key": "ctrl+shift+tab", "command": "workbench.action.openPreviousEditor" },
  { "key": "ctrl+pageup", "command": "workbench.action.openPreviousEditor" },
  { "key": "ctrl+pagedown", "command": "workbench.action.openNextEditor" },
  { "key": "ctrl+1", "command": "workbench.action.focusFirstEditorGroup" },
  { "key": "ctrl+2", "command": "workbench.action.focusSecondEditorGroup" },
  { "key": "ctrl+3", "command": "workbench.action.focusThirdEditorGroup" },
  { "key": "ctrl+4", "command": "workbench.action.focusFourthEditorGroup" },
  { "key": "ctrl+\\", "command": "workbench.action.splitEditor" },
  {
    "key": "ctrl+k ctrl+left",
    "command": "workbench.action.focusPreviousGroup"
  },
  { "key": "ctrl+k ctrl+right", "command": "workbench.action.focusNextGroup" },

  // View + workbench
  { "key": "ctrl+b", "command": "workbench.action.toggleSidebarVisibility" },
  { "key": "ctrl+shift+e", "command": "workbench.view.explorer" },
  { "key": "ctrl+shift+g", "command": "workbench.view.scm" },
  { "key": "ctrl+shift+d", "command": "workbench.view.debug" },
  { "key": "ctrl+shift+x", "command": "workbench.view.extensions" },
  { "key": "ctrl+shift+m", "command": "workbench.actions.view.problems" },
  { "key": "ctrl+shift+y", "command": "workbench.debug.action.toggleRepl" },
  { "key": "ctrl+0", "command": "workbench.action.focusActiveEditorGroup" },
  { "key": "ctrl+shift+u", "command": "workbench.action.output.toggleOutput" },

  // Terminal
  { "key": "ctrl+`", "command": "workbench.action.terminal.toggleTerminal" },
  { "key": "ctrl+shift+`", "command": "workbench.action.terminal.new" },
  {
    "key": "ctrl+shift+c",
    "command": "workbench.action.terminal.copySelection",
    "when": "terminalFocus && terminalTextSelected"
  },
  {
    "key": "ctrl+shift+v",
    "command": "workbench.action.terminal.paste",
    "when": "terminalFocus"
  },
  { "key": "ctrl+shift+b", "command": "workbench.action.tasks.build" },
  { "key": "ctrl+shift+f5", "command": "workbench.action.debug.restart" },
  { "key": "ctrl+f5", "command": "workbench.action.debug.start" },

  // Explorer-specific copy/paste
  {
    "key": "ctrl+v",
    "command": "filesExplorer.paste",
    "when": "explorerViewletVisible && filesExplorerFocus && !explorerResourceReadonly && !inputFocus"
  },
  {
    "key": "ctrl+c",
    "command": "filesExplorer.copy",
    "when": "explorerViewletVisible && filesExplorerFocus && !explorerResourceIsRoot && !inputFocus"
  },

  // Keybindings editor copy
  {
    "key": "ctrl+c",
    "command": "keybindings.editor.copyKeybindingEntry",
    "when": "inKeybindings && keybindingFocus && !whenFocus"
  },

  // Search / results copy
  {
    "key": "ctrl+c",
    "command": "search.action.copyMatch",
    "when": "fileMatchOrMatchFocus"
  },

  // Terminal copy fallback
  {
    "key": "ctrl+c",
    "command": "workbench.action.terminal.copySelection",
    "when": "terminalFocus && terminalTextSelected"
  },

  // Notebook / markdown / editor paste fallbacks
  {
    "key": "ctrl+v",
    "command": "notebook.cell.pasteAbove",
    "when": "notebookEditorFocused && !inputFocus"
  },
  {
    "key": "ctrl+v",
    "command": "notebook.cell.paste",
    "when": "notebookEditorFocused && inputFocus"
  },

  // Cursor navigation
  {
    "key": "ctrl+right",
    "command": "cursorWordRight",
    "when": "textInputFocus"
  },
  { "key": "ctrl+left", "command": "cursorWordLeft", "when": "textInputFocus" },
  {
    "key": "ctrl+shift+right",
    "command": "cursorWordPartRightSelect",
    "when": "textInputFocus"
  },
  {
    "key": "ctrl+shift+left",
    "command": "cursorWordPartLeftSelect",
    "when": "textInputFocus"
  }
]
