# =========================================================================
# GHOSTTY CONFIGURATION (~/.config/ghostty/config)
# Dracula-themed native GPU terminal setup.
# Full option reference: https://ghostty.org/docs/config
# =========================================================================

# --- Font ---
font-family = "JetBrainsMono Nerd Font Mono"
font-size = 12

# --- Cursor ---
cursor-style = "bar"
cursor-style-blink = true

# --- Scrollback ---
scrollback-limit = 100000

# --- Window ---
window-padding-x = 8
window-padding-y = 8
background-opacity = 0.92
quit-after-last-window-closed = false
confirm-close-surface = false

# --- macOS ---
macos-option-as-alt = true

# --- Unified copy/paste (same on macOS + Fedora) ---
# performable: only consumes the key when the action can run. For copy,
# that means text is selected; otherwise ctrl+c falls through as SIGINT.
# Plain ctrl+c=copy_to_clipboard always eats the key and breaks interrupt.
# Docs: https://ghostty.org/docs/config/keybind
keybind = performable:ctrl+c=copy_to_clipboard
keybind = ctrl+v=paste_from_clipboard
keybind = performable:ctrl+insert=copy_to_clipboard
keybind = shift+insert=paste_from_clipboard
# Shift+Ctrl variants kept as muscle-memory aliases (Linux heritage).
keybind = performable:ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard

# --- Ninja keys (performance-first, Ctrl-led like the IDEs) ---
keybind = ctrl+t=new_tab
keybind = ctrl+w=close_surface
keybind = ctrl+d=new_split:right
keybind = ctrl+shift+d=new_split:down
keybind = ctrl+equal=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size
keybind = ctrl+f=toggle_split_zoom
keybind = ctrl+k=clear_screen
keybind = ctrl+shift+f=toggle_search

# --- Colors: Dracula ---
foreground = #f8f8f2
background = #282a36
selection-foreground = #ffffff
selection-background = #44475a
cursor-color = #f8f8f2
cursor-text = #282a36

# Normal colors
palette = 0=#21222c
palette = 1=#ff5555
palette = 2=#50fa7b
palette = 3=#f1fa8c
palette = 4=#bd93f9
palette = 5=#ff79c6
palette = 6=#8be9fd
palette = 7=#f8f8f2

# Bright colors
palette = 8=#6272a4
palette = 9=#ff6e6e
palette = 10=#69ff94
palette = 11=#ffffa5
palette = 12=#d6acff
palette = 13=#ff92df
palette = 14=#a4ffff
palette = 15=#ffffff
