# =========================================================================
# GHOSTTY CONFIGURATION (~/.config/ghostty/config)
# Dracula-themed native GPU terminal setup.
# Full option reference: https://ghostty.org/docs/config
# =========================================================================

# --- Font ---
font-family = "JetBrainsMono Nerd Font Mono"
font-size = 12

# --- Cursor ---
cursor-style = "bar"
cursor-style-blink = true

# --- Scrollback ---
scrollback-limit = 100000

# --- Window ---
window-padding-x = 8
window-padding-y = 8
background-opacity = 0.92
quit-after-last-window-closed = false
confirm-close-surface = false

# --- macOS ---
macos-option-as-alt = true

# --- Colors: Dracula ---
foreground = #f8f8f2
background = #282a36
selection-foreground = #ffffff
selection-background = #44475a
cursor-color = #f8f8f2
cursor-text = #282a36

# Normal colors
palette = 0=#21222c
palette = 1=#ff5555
palette = 2=#50fa7b
palette = 3=#f1fa8c
palette = 4=#bd93f9
palette = 5=#ff79c6
palette = 6=#8be9fd
palette = 7=#f8f8f2

# Bright colors
palette = 8=#6272a4
palette = 9=#ff6e6e
palette = 10=#69ff94
palette = 11=#ffffa5
palette = 12=#d6acff
palette = 13=#ff92df
palette = 14=#a4ffff
palette = 15=#ffffff
