[tools]
java = "latest"
rust = "latest"
node = "latest"
python = "latest"
starship = "latest"
usage = "latest"
uv = "latest"
dart = "latest"

# CLI tools
chezmoi = "latest"
ripgrep = "latest"
bat = "latest"
fd = "latest"
eza = "latest"
delta = "latest"
dust = "latest"
duf = "latest"
fzf = "latest"
zoxide = "latest"
lazygit = "latest"
lazydocker = "latest"
gping = "latest"
bottom = "latest"
atuin = "latest"
# Version managers / cross-platform CLIs: if mise can install it, it lives HERE.
# Never duplicate these in generic package manifests (see docs/DECISION.md).
# Existing system copies are left alone; remove them manually when desired.
gh = "latest"
{{ if .is_work -}}
kubectl = "latest"      # WORK ONLY: not installed on personal machines
{{ end -}}
gum = "latest"
yazi = "latest"
"cargo:procs" = "latest"
"cargo:tokei" = "latest"

[settings]
idiomatic_version_file_enable_tools = ["node"]
python.github_attestations = false
github_attestations = false
