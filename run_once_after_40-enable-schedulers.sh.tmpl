#!/usr/bin/env bash
# Enable the weekly auto-update scheduler for this OS. Runs once per machine.
set -euo pipefail
OS="$(uname -s)"

if [ "$OS" = "Darwin" ]; then
  PLIST="$HOME/Library/LaunchAgents/com.dotfiles.update.plist"
  if [ -f "$PLIST" ]; then
    LABEL="$(/usr/bin/plutil -extract Label raw "$PLIST" 2>/dev/null || echo com.dotfiles.update)"
    launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true
    launchctl bootstrap "gui/$(id -u)" "$PLIST"
    # Verify via print (not `list | grep -q`): under pipefail, grep -q closes
    # the pipe early → SIGPIPE 141 exactly when the job *is* loaded.
    launchctl print "gui/$(id -u)/$LABEL" &>/dev/null
    echo "schedulers: launchd weekly update enabled and verified (Wed 10:00)"
  fi
elif [ "$OS" = "Linux" ]; then
  if command -v systemctl &>/dev/null; then
    systemctl --user daemon-reload 2>/dev/null || true
    systemctl --user enable --now dotfiles-update.timer
    systemctl --user is-enabled dotfiles-update.timer &>/dev/null
    echo "schedulers: systemd weekly update enabled and verified (Wed 10:00)"
  fi
fi
