#!/usr/bin/env bash
# Enable the weekly auto-update scheduler for this OS. Runs once per machine.
set -euo pipefail
OS="$(uname -s)"

if [ "$OS" = "Darwin" ]; then
  PLIST="$HOME/Library/LaunchAgents/com.dotfiles.update.plist"
  if [ -f "$PLIST" ]; then
    launchctl bootout "gui/$(id -u)/$(
      /usr/bin/plutil -extract Label raw "$PLIST" 2>/dev/null || echo com.dotfiles.update
    )" 2>/dev/null || true
    launchctl bootstrap "gui/$(id -u)" "$PLIST" 2>/dev/null || true
    echo "schedulers: launchd weekly update enabled (Wed 10:00)"
  fi
elif [ "$OS" = "Linux" ]; then
  if command -v systemctl &>/dev/null; then
    systemctl --user daemon-reload 2>/dev/null || true
    systemctl --user enable --now dotfiles-update.timer 2>/dev/null || true
    echo "schedulers: systemd weekly update enabled (Wed 10:00)"
  fi
fi
