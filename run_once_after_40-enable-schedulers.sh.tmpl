#!/usr/bin/env bash
# Enable the weekly auto-update scheduler for this OS. Runs once per machine.
set -euo pipefail
OS="$(uname -s)"

if [ "$OS" = "Darwin" ]; then
  PLIST="$HOME/Library/LaunchAgents/com.dotfiles.update.plist"
  if [ -f "$PLIST" ]; then
    launchctl bootout "gui/$(id -u)/$(
      /usr/bin/plutil -extract Label raw "$PLIST" 2>/dev/null || echo com.dotfiles.update
    )" 2>/dev/null || true
    launchctl bootstrap "gui/$(id -u)" "$PLIST"
    # Verify loudly: a scheduler that silently failed to load leaves the
    # machine without weekly updates and nobody finds out (doctor re-checks).
    launchctl list | grep -q com.dotfiles.update
    echo "schedulers: launchd weekly update enabled and verified (Wed 10:00)"
  fi
elif [ "$OS" = "Linux" ]; then
  if command -v systemctl &>/dev/null; then
    systemctl --user daemon-reload 2>/dev/null || true
    systemctl --user enable --now dotfiles-update.timer
    systemctl --user is-enabled dotfiles-update.timer &>/dev/null
    echo "schedulers: systemd weekly update enabled and verified (Wed 10:00)"
  fi
fi
