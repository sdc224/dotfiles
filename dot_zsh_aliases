# =========================================================================
# CORE ALIASES
# =========================================================================
# =========================================================================
# SMART GUI LAUNCHER (Silences Electron/V8 noise)
# =========================================================================
# Launches GUI apps silently and detaches them from the terminal.
# Preserves output if flags (like --help or -v) are used.
_gui_launch() {
  local cmd="$1"
  shift
  if [[ "$1" == -* ]]; then
    # CLI mode: run normally
    command "$cmd" "$@"
  else
    # GUI mode: silence output and detach (background + disown)
    # The '&!' is Zsh syntax for backgrounding and disowning immediately.
    command "$cmd" "$@" >/dev/null 2>&1 &!
  fi
}

alias code='_gui_launch code'
alias ag='_gui_launch antigravity'
alias cr='_gui_launch cursor'
alias slack='_gui_launch slack'
alias discord='_gui_launch discord'
alias obsidian='_gui_launch obsidian'
alias :q="exit"
alias reload='exec zsh'
alias cd='z'

# Modern CLI Replacements (Rust-based)
if command -v eza &>/dev/null; then
  alias ls='eza --git --icons --classify --group-directories-first'
  alias ll='eza -la --git --icons --group-directories-first'
  alias lt='eza --tree --level=2 --icons'
fi

if command -v bat &>/dev/null; then
  alias cat='bat --paging=never'
  alias dog='bat'
fi

if command -v procs &>/dev/null; then
  alias ps='procs'
fi

if command -v bottom &>/dev/null; then
  alias top='btm'
  alias htop='btm'
fi

if command -v duf &>/dev/null; then
  alias df='duf'
fi

if command -v dust &>/dev/null; then
  alias du='dust'
fi

