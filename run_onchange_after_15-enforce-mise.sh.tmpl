#!/usr/bin/env bash
# Guard: mise owns node/python/java/kubectl/gum/gh. Uninstall brew copies.
# Re-runs on every apply (run_onchange hash of mise config).
# Mise config hash: {{ include "dot_config/mise/config.toml.tmpl" | sha256sum }}
set -euo pipefail

BANNED_FORMULAE=("node" "python@3.13" "python@3.12" "python@3.11" "kubernetes-cli" "gum")
BANNED_CASKS=()

if ! command -v brew &>/dev/null; then
  exit 0
fi

# Only enforce on macOS; Fedora uses dnf (mise still owns the same tools there,
# but dnf never installs them, so nothing to remove).
if [ "$(uname -s)" != "Darwin" ]; then
  exit 0
fi

removed=0
for pkg in "${BANNED_FORMULAE[@]}"; do
  if brew list "$pkg" &>/dev/null; then
    echo "enforce-mise: removing brew duplicate '$pkg' (owned by mise)"
    brew uninstall "$pkg" || true
    removed=1
  fi
done
for cask in "${BANNED_CASKS[@]}"; do
  if brew list --cask "$cask" &>/dev/null; then
    echo "enforce-mise: removing cask duplicate '$cask' (owned by mise)"
    brew uninstall --cask "$cask" || true
    removed=1
  fi
done

# Warn (do not uninstall) about hidden brew python, which is fine as a
# transitive dependency of awscli/mysql. Only warn if user explicitly
# installed it on top level, detected via `brew leaves` when available.
if brew list python@3.13 &>/dev/null; then
  echo "enforce-mise: note: brew python@3.13 present (ok if pulled by awscli/mysql; dev python stays in mise)" >&2
fi

exit 0
