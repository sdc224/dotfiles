# Dotfiles helper scripts and mise install here. Put them ahead of system
# locations for every subsequent login shell; the initial verification in the
# README still uses absolute paths because this file is not sourced yet.
export PATH="$HOME/.local/bin:$PATH"

# Homebrew (macOS). Official install leaves /opt/homebrew off PATH until the
# shell sources this. Apply hooks must eval shellenv themselves (see dispatcher)
# because they never source ~/.zprofile.
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

if [[ -d "/Applications/JetBrains Toolbox.app" ]] || [[ -d "$HOME/.local/share/JetBrains/Toolbox" ]]; then
  export PATH="$PATH:/usr/local/bin"
fi


# Added by Toolbox App
export PATH="$PATH:/Users/schatterjee10/Library/Application Support/JetBrains/Toolbox/scripts"


# mise shims ahead of system/Homebrew paths for login shells that never source
# ~/.zshrc (IDE/agent/tool shells). /etc/zprofile path_helper runs before this.
export PATH="$HOME/.local/share/mise/shims:$PATH"
