#!/usr/bin/env bash
# Bootstrap: first-contact setup for a brand-new machine.
# Runs once (run_once). This is the only place OS primitives needed to
# *converge* should be installed — smoke/CI must not pre-seed them.
#
# After this script: dispatcher (10) + mise (20) + the rest can run.
# Prerequisite from the human: curl + network (see README / MANUAL.md).
set -euo pipefail

OS="$(uname -s)"

if [ "$OS" = "Darwin" ]; then
  if ! command -v brew &>/dev/null; then
    echo "bootstrap: installing Homebrew for $(uname -m)..."
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  fi
  if [ -f "/opt/homebrew/bin/brew" ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  elif [ -f "/usr/local/bin/brew" ]; then
    eval "$(/usr/local/bin/brew shellenv)"
  fi
  brew list git &>/dev/null || brew install git
elif [ "$OS" = "Linux" ]; then
  if command -v dnf &>/dev/null; then
    echo "bootstrap: installing Fedora converge primitives..."
    # git/curl/zsh/flatpak: base converge + Ghostty flatpak path
    # python3: dispatcher TOML merge
    # gcc/libatomic: mise cargo:* compile + Node libatomic.so.1
    # tar/gzip/unzip/fontconfig/findutils/which/diffutils: fonts, scripts, ide-keys
    # gh: early GitHub CLI until mise install provides the managed one
    sudo dnf install -y \
      git curl zsh flatpak gh \
      python3 \
      gcc libatomic \
      tar gzip unzip fontconfig findutils which diffutils
  elif command -v apt &>/dev/null; then
    echo "bootstrap: installing Debian/Ubuntu converge primitives..."
    sudo apt-get update
    sudo apt-get install -y \
      git curl zsh flatpak \
      python3 \
      gcc libatomic1 \
      tar gzip unzip fontconfig findutils debianutils diffutils
  fi
  # Nerd Fonts (Linux): JetBrains Mono + Meslo for Ghostty/VS Code parity.
  # Best-effort only — not required to converge. GitHub release CDNs 504 in CI.
  FONT_DIR="$HOME/.local/share/fonts/NerdFonts"
  if [ ! -d "$FONT_DIR" ] ||
    ! find "$FONT_DIR" \( -name '*.ttf' -o -name '*.otf' \) 2>/dev/null | grep -q .; then
    echo "bootstrap: installing Nerd Fonts..."
    mkdir -p "$FONT_DIR"
    for nf in JetBrainsMono Meslo; do
      if curl --retry 5 --retry-delay 2 --retry-all-errors -fL \
        -o "/tmp/${nf}.tar.xz" \
        "https://github.com/ryanoasis/nerd-fonts/releases/latest/download/${nf}.tar.xz"; then
        tar -xf "/tmp/${nf}.tar.xz" -C "$FONT_DIR" || \
          echo "bootstrap: warning: extract $nf failed (non-fatal)" >&2
      else
        echo "bootstrap: warning: download $nf failed (non-fatal)" >&2
      fi
    done
    fc-cache -fv "$FONT_DIR" || true
  fi
fi

# mise: owns all runtimes + Rust CLIs (see docs/DECISION.md).
if ! command -v mise &>/dev/null && [ ! -x "$HOME/.local/bin/mise" ]; then
  echo "bootstrap: installing mise..."
  curl --retry 5 --retry-delay 2 --retry-all-errors -fsSL https://mise.run | sh
fi
export PATH="$HOME/.local/bin:$PATH"

# zinit (zsh plugin manager, turbo mode).
ZINIT_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}/zinit/zinit.git"
if [ ! -d "$ZINIT_HOME" ]; then
  echo "bootstrap: installing zinit..."
  mkdir -p "$(dirname "$ZINIT_HOME")"
  git clone https://github.com/zdharma-continuum/zinit.git "$ZINIT_HOME"
fi

echo "bootstrap: done. Converge with: chezmoi apply"
