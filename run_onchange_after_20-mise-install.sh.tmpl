#!/usr/bin/env bash
# Install/upgrade every mise tool from dot_config/mise/config.toml.
# Re-runs when the mise config changes (hash below alters script content).
# Mise config hash: {{ include "dot_config/mise/config.toml.tmpl" | sha256sum }}
set -euo pipefail
export PATH="$HOME/.local/bin:$PATH"

if ! command -v mise &>/dev/null; then
  echo "mise-install: mise missing (bootstrap should have installed it), skipping" >&2
  exit 0
fi

# Prefer an already-exported token (CI: MISE_GITHUB_TOKEN / GITHUB_TOKEN), then
# `gh auth` on a logged-in machine. Unauthenticated installs hit the 60/hr
# GitHub API cap — fatal on shared CI runner IPs.
if [ -z "${MISE_GITHUB_TOKEN:-}${GITHUB_TOKEN:-}${GITHUB_API_TOKEN:-}" ]; then
  if command -v gh &>/dev/null && gh auth token &>/dev/null 2>&1; then
    GITHUB_TOKEN="$(gh auth token)"
    export GITHUB_TOKEN
  else
    echo "mise-install: no GitHub token; installs may hit API rate limits" >&2
  fi
fi

mise install --yes
