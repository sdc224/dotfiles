#!/usr/bin/env bash
# Install/upgrade every mise tool from dot_config/mise/config.toml.
# Re-runs when the mise config changes (hash below alters script content).
# Mise config hash: {{ include "dot_config/mise/config.toml.tmpl" | sha256sum }}
set -euo pipefail
export PATH="$HOME/.local/bin:$PATH"

if ! command -v mise &>/dev/null; then
  echo "mise-install: mise missing (bootstrap should have installed it), skipping" >&2
  exit 0
fi

if command -v gh &>/dev/null && gh auth token &>/dev/null 2>&1; then
  GITHUB_TOKEN="$(gh auth token)" mise install --yes
else
  mise install --yes
fi
